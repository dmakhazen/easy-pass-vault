<Application x:Class="EasyPassVault.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ThemeMode="Light">
 <Application.Resources>
  <SolidColorBrush x:Key="Green" Color="#2F7059"/>
  <SolidColorBrush x:Key="Secondary" Color="#56665B"/>
  <SolidColorBrush x:Key="PendingSaveForeground" Color="#754700"/>
  <SolidColorBrush x:Key="PendingSaveBackground" Color="#FFF1CF"/>
  <SolidColorBrush x:Key="FolderDropBrush" Color="#CDE7D9"/>
  <SolidColorBrush x:Key="FolderSelectedBrush" Color="#DCE8DF"/>
  <SolidColorBrush x:Key="ActiveSearchBackground" Color="#E4F4EC"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#263832"/><Setter Property="Background" Value="#FAFBF8"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Background" Value="#F1F5F2"/>
   <Setter Property="Foreground" Value="#263832"/>
   <Setter Property="BorderBrush" Value="#D8E3DC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#718A7E"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1D5944"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/></Style>
  <!-- Header buttons: the mockup's 8x12 padding, spacing comes from the left margin. -->
  <Style x:Key="Header" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style x:Key="HeaderPrimary" TargetType="Button" BasedOn="{StaticResource Header}"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,7"/></Style>
  <Style x:Key="HeaderIcon" TargetType="Button" BasedOn="{StaticResource Header}"><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/></Style>
  <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="White"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Plain}"><Setter Property="BorderBrush" Value="#E3C9C4"/><Setter Property="Foreground" Value="#96483D"/></Style>
  <!-- Segmented switch: buttons sit inside a #E9EFEA track, the active one is white. -->
  <Style x:Key="Segment" TargetType="Button">
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#43564D"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
              CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter RecognizesAccessKey="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1D5944"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SegmentActive" TargetType="Button" BasedOn="{StaticResource Segment}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263832"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <!-- A folder row that is a button ("All folders"): same look as the rows of the tree. Tag="Selected" marks it. -->
  <Style x:Key="FolderRow" TargetType="Button">
   <Setter Property="Padding" Value="8,7"/>
   <Setter Property="Foreground" Value="#263832"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter RecognizesAccessKey="False"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E9EFEA"/></Trigger>
       <Trigger Property="Tag" Value="Selected"><Setter TargetName="Surface" Property="Background" Value="{StaticResource FolderSelectedBrush}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1D5944"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- 16x16 stroke icons of the copy buttons. -->
  <Geometry x:Key="CopyIcon">M6.5,5 H11.5 A1.5,1.5 0 0 1 13,6.5 V11.5 A1.5,1.5 0 0 1 11.5,13 H6.5 A1.5,1.5 0 0 1 5,11.5 V6.5 A1.5,1.5 0 0 1 6.5,5 Z M3,11 V4 A1,1 0 0 1 4,3 H11</Geometry>
  <Geometry x:Key="UserIcon">M5.5,5.5 A2.5,2.5 0 1 1 10.5,5.5 A2.5,2.5 0 1 1 5.5,5.5 Z M3,13.5 C3.6,11.1 5.6,10 8,10 C10.4,10 12.4,11.1 13,13.5</Geometry>
  <Geometry x:Key="SearchIcon">M2.5,7 A4.5,4.5 0 1 1 11.5,7 A4.5,4.5 0 1 1 2.5,7 Z M10.5,10.5 L14,14</Geometry>
  <!-- Generator: a die with a sparkle, read as "make a random one". -->
  <Geometry x:Key="DiceIcon">M3.5,5 H10.5 A1.5,1.5 0 0 1 12,6.5 V12.5 A1.5,1.5 0 0 1 10.5,14 H3.5 A1.5,1.5 0 0 1 2,12.5 V6.5 A1.5,1.5 0 0 1 3.5,5 Z M4.6,8 A0.6,0.6 0 1 1 5.8,8 A0.6,0.6 0 1 1 4.6,8 Z M8.2,11 A0.6,0.6 0 1 1 9.4,11 A0.6,0.6 0 1 1 8.2,11 Z M13,1 V4.5 M11.25,2.75 H14.75</Geometry>
  <Geometry x:Key="ClipIcon">M13,7.5 L7.8,12.7 A3,3 0 0 1 3.5,8.5 L9.1,2.9 A2,2 0 0 1 12,5.7 L6.5,11.2 A1,1 0 0 1 5.1,9.8 L10,4.9</Geometry>
  <Geometry x:Key="KeyIcon">M3,10.5 A2.5,2.5 0 1 1 8,10.5 A2.5,2.5 0 1 1 3,10.5 Z M7.5,8.5 L13,3 M11,5 L12.5,6.5</Geometry>
  <!-- Buttons to the right of an editor field. -->
  <Style x:Key="FieldAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Padding" Value="12,7"/></Style>
  <Style x:Key="FieldActionPrimary" TargetType="Button" BasedOn="{StaticResource FieldAction}"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <!-- 30x30 icon buttons in a list row: copy login, copy password. -->
  <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#B9CBBF"/><Setter Property="Foreground" Value="#2F5D4B"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="False"/></Style>
  <Style x:Key="RowIconPrimary" TargetType="Button" BasedOn="{StaticResource RowIcon}"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/></Style>
  <!-- Small white buttons: sort order, folder actions. -->
  <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,2"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263832"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <!-- "+ New folder": a quiet button with a dashed outline. -->
  <Style x:Key="Dashed" TargetType="Button">
   <Setter Property="Padding" Value="8"/>
   <Setter Property="Foreground" Value="#2F5D4B"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid x:Name="Surface" Background="Transparent">
       <Rectangle x:Name="Outline" Stroke="#A9B9AF" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"/>
       <ContentPresenter RecognizesAccessKey="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="#718A7E"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="#1D5944"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#54655C"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,8"/>
   <Setter Property="Background" Value="#FAFBF8"/>
   <Setter Property="Foreground" Value="#263832"/>
   <Setter Property="BorderBrush" Value="#D6DFD5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Padding" Value="8,8"/>
   <Setter Property="Background" Value="#FAFBF8"/>
   <Setter Property="Foreground" Value="#263832"/>
   <Setter Property="BorderBrush" Value="#D6DFD5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,9,12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectionBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="Background" Value="#ECF1E8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="Background" Value="#E1EADE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
