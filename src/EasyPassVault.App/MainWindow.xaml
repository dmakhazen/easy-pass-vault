<Window x:Class="EasyPassVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EasyPassVault.App" Title="easy-pass-vault" Icon="Assets/vault.ico" Width="1180" Height="760" MinWidth="950" MinHeight="640" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Closing="OnClosing">
 <Window.Resources><local:ItemTitleConverter x:Key="ItemTitleConverter"/></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DFE6E2" BorderThickness="0,0,0,1" Padding="18,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Source="Assets/vault.png" Width="36" Height="36" Stretch="Uniform" AutomationProperties.Name="{DynamicResource Ui.0}"/><TextBlock Text="easy-pass-vault" FontSize="20" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0" TextBlock.Foreground="#758376">
     <TextBlock x:Name="VaultName" Text="{DynamicResource Ui.1}" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="SavedAt" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <StackPanel x:Name="VersionActions" Orientation="Horizontal" Visibility="Collapsed">
      <Button x:Name="SaveButton" Content="{DynamicResource Ui.25}" Click="SaveClick" Style="{StaticResource Primary}" IsEnabled="False"/>
      <Button x:Name="SaveVersionButton" Click="SaveVersionClick"/>
      <Border x:Name="VersionHelp" Background="#E1EADE" CornerRadius="12" Width="24" Height="24"
              Tag="{DynamicResource Ui.3}"
              VerticalAlignment="Center" Margin="4,0,8,0" Focusable="True" Cursor="Help"
              ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="150">
       <Border.ToolTip>
        <ToolTip>
         <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                    TextWrapping="Wrap" MaxWidth="320"/>
        </ToolTip>
       </Border.ToolTip>
       <TextBlock Text="?" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </StackPanel>
     <Button x:Name="ExportButton" Content="{DynamicResource Ui.74}" Click="ExportClick" Visibility="Collapsed"/>
    </StackPanel>
    <Border x:Name="SaveStateBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
            Padding="8,4" CornerRadius="5">
     <TextBlock x:Name="SaveState" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    </DockPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="LockButton" Content="{DynamicResource Ui.4}" Click="LockClick" IsEnabled="False" Visibility="Collapsed"/>
     <ComboBox x:Name="LanguagePicker" MinWidth="95" VerticalAlignment="Center" Margin="8,0,0,0"
               AutomationProperties.Name="{DynamicResource Ui.5}" SelectionChanged="LanguageChanged"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#F1F4EF" Padding="16,6"><TextBlock x:Name="Status" Text="{DynamicResource Ui.6}" TextWrapping="Wrap" FontSize="12"/></Border>
  <Grid>
   <Grid x:Name="Welcome">
    <StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="{DynamicResource Ui.7}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock Text="{DynamicResource Ui.8}" TextWrapping="Wrap" Foreground="#758376" Margin="0,0,0,24"/>
     <Button Content="{DynamicResource Ui.9}" Style="{StaticResource Primary}" Click="OpenClick" Padding="16,13"/>
     <Button Content="{DynamicResource Ui.10}" Click="CreateClick" Padding="16,13"/>
     <TextBlock Text="{DynamicResource Ui.87}" TextWrapping="Wrap" Margin="3,14,3,0"/>
     <TextBlock Text="{DynamicResource Ui.11}" TextWrapping="Wrap" FontSize="12" Foreground="#887548" Margin="0,22,0,0"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="Workspace" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F4F6F1" BorderBrush="#DCE3DC" BorderThickness="0,0,1,0" Padding="10,22">
     <DockPanel><TextBlock DockPanel.Dock="Top" Text="{DynamicResource Ui.12}" Margin="12,0,0,15" FontSize="11" Foreground="#758376"/>
      <StackPanel DockPanel.Dock="Bottom">
       <Button Content="{DynamicResource Ui.13}" Click="AddFolderClick"/>
       <Button Content="{DynamicResource Ui.14}" Click="RenameFolderClick"/>
       <Button x:Name="DeleteFolderButton" Content="{DynamicResource Ui.15}" Click="DeleteFolderClick"
               IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
      </StackPanel>
      <Button x:Name="AllFoldersButton" DockPanel.Dock="Top" Content="{DynamicResource Ui.16}"
              Click="AllFoldersClick" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
      <TreeView x:Name="FolderList" SelectedItemChanged="FolderChanged" PreviewMouseMove="DragSourceMouseMove"
                PreviewMouseLeftButtonUp="DragSourceMouseUp"
                Background="Transparent" BorderThickness="0">
       <TreeView.Resources>
        <Style TargetType="TreeViewItem">
         <Setter Property="HeaderTemplate">
          <Setter.Value>
           <DataTemplate>
            <Border Background="Transparent" CornerRadius="4" Padding="4,5" AllowDrop="True"
                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                    PreviewMouseLeftButtonDown="FolderHeaderPressed" DragOver="FolderHeaderDragOver"
                    DragLeave="FolderHeaderDragLeave" Drop="FolderHeaderDrop">
             <StackPanel Orientation="Horizontal">
              <Path Fill="#56836E" Width="16" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                    VerticalAlignment="Center" Data="M 0,2 L 6,2 L 8,4 L 16,4 L 16,13 L 0,13 Z"/>
              <Border Background="#E3E8E5" CornerRadius="10" MinWidth="20" Padding="5,1"
                      Margin="0,0,6,0" VerticalAlignment="Center">
               <TextBlock Text="{Binding Count}" Foreground="#43564D" FontSize="11" TextAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
             </StackPanel>
            </Border>
           </DataTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </TreeView.Resources>
      </TreeView>
     </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="#FBFCFA" BorderBrush="#DCE3DC" BorderThickness="0,0,1,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
       <TextBlock x:Name="FolderTitle" Text="{DynamicResource Ui.16}" FontSize="21" Margin="0,0,0,14"/>
       <UniformGrid Columns="3">
        <Button x:Name="AllCategory" Click="AllCategoryClick" Padding="5,8"/>
        <Button x:Name="LoginCategory" Content="{DynamicResource Ui.17}" Click="LoginCategoryClick" Padding="5,8"/>
        <Button x:Name="TextCategory" Content="{DynamicResource Ui.18}" Click="TextCategoryClick" Padding="5,8"/>
       </UniformGrid>
       <Grid Margin="0,14,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="{DynamicResource Ui.19}" AutomationProperties.Name="{DynamicResource Ui.20}"/>
        <TextBlock x:Name="SearchHint" Text="{DynamicResource Ui.20}" Foreground="#667466" Margin="11,0"
                   VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
             <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" Click="ClearSearchClick"
                ToolTip="{DynamicResource Ui.93}" AutomationProperties.Name="{DynamicResource Ui.93}"
                Padding="8,4" Margin="4,0,0,0" Visibility="Collapsed"/>
       </Grid>
       <TextBlock x:Name="SearchNoResults" Text="{DynamicResource Ui.94}" Visibility="Collapsed"
                  Foreground="#436657" TextWrapping="Wrap" Margin="4,0,4,8"/>
       <UniformGrid Columns="2"><Button Content="{DynamicResource Ui.21}" Click="AddLoginClick"/><Button Content="{DynamicResource Ui.22}" Click="AddTextClick"/></UniformGrid>
      </StackPanel>
      <ListBox x:Name="ItemList" SelectionChanged="ItemChanged" PreviewMouseLeftButtonDown="ItemListPressed"
               PreviewMouseMove="DragSourceMouseMove" PreviewMouseLeftButtonUp="DragSourceMouseUp">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <StackPanel>
          <TextBlock Text="{Binding Converter={StaticResource ItemTitleConverter}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Login}" FontSize="12" Foreground="#758376" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
         </StackPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Grid Grid.Column="2" Background="White">
     <TextBlock x:Name="EmptyEditor" Text="{DynamicResource Ui.23}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#758376" TextAlignment="Center"/>
     <DockPanel x:Name="Editor" Visibility="Collapsed">
      <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,14">
       <Button x:Name="RevertButton" Click="RevertClick" HorizontalAlignment="Right" Visibility="Collapsed"/>
       <TextBlock x:Name="KindCaption" Foreground="#758376" FontSize="12"/>
       <TextBlock x:Name="EditorTitle" FontSize="24" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,12"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,6,0">
         <TextBlock Text="{DynamicResource Ui.26}" Foreground="#54655C" FontSize="11" Margin="0,0,0,4"/>
         <TextBox x:Name="TitleField" TextChanged="FieldChanged"/>
        </StackPanel>
        <StackPanel Margin="6,0,0,0">
         <TextBlock Text="{DynamicResource Ui.27}" Foreground="#54655C" FontSize="11" Margin="0,0,0,4"/>
         <ComboBox x:Name="ItemFolder" DisplayMemberPath="Name" Padding="8" SelectionChanged="ItemFolderChanged"/>
        </StackPanel>
       </UniformGrid>
       <StackPanel x:Name="LoginFields">
        <UniformGrid Columns="2" Margin="0,10,0,0">
         <StackPanel Margin="0,0,6,0">
          <TextBlock Text="{DynamicResource Ui.28}" Foreground="#54655C" FontSize="11" Margin="0,0,0,4"/>
          <TextBox x:Name="LoginField" TextChanged="FieldChanged"/>
         </StackPanel>
         <StackPanel Margin="6,0,0,0">
          <TextBlock Text="{DynamicResource Ui.29}" Foreground="#54655C" FontSize="11" Margin="0,0,0,4"/>
          <DockPanel>
           <Button DockPanel.Dock="Right" x:Name="ShowPassword" Content="{DynamicResource Ui.30}" Click="ShowPasswordClick" Margin="6,0,0,0"/>
           <Grid><PasswordBox x:Name="PasswordField" PasswordChanged="PasswordChanged"/><TextBox x:Name="VisiblePassword" Visibility="Collapsed" TextChanged="VisiblePasswordChanged"/></Grid>
          </DockPanel>
         </StackPanel>
        </UniformGrid>
        <TextBlock Text="{DynamicResource Ui.32}" Foreground="#54655C" FontSize="11" Margin="0,10,0,4"/><TextBox x:Name="SiteField" TextChanged="FieldChanged"/>
       </StackPanel>
       <TextBlock x:Name="TextCaption" Text="{DynamicResource Ui.33}" Foreground="#54655C" FontSize="11" Margin="0,10,0,4"/>
       <TextBox x:Name="TextField" AcceptsReturn="True" AcceptsTab="True" MinHeight="92" TextWrapping="Wrap"
                TextAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="FieldChanged"/>
       <Button Content="{DynamicResource Ui.34}" Click="DeleteItemClick" Foreground="#A35C52" HorizontalAlignment="Right" Margin="0,10,0,0"/>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
