<Window x:Class="EasyPassVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="easy-pass-vault" Icon="Assets/vault.ico" Width="1180" Height="800" MinWidth="950" MinHeight="640" Closing="OnClosing">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#FAFBF8" BorderBrush="#DCE3DC" BorderThickness="0,0,0,1" Padding="20,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Source="Assets/vault.png" Width="46" Height="46" Stretch="Uniform" AutomationProperties.Name="easy-pass-vault: документ с замком"/><TextBlock Text="easy-pass-vault" FontSize="22" FontWeight="SemiBold" Margin="13,0" VerticalAlignment="Center"/></StackPanel>
    <TextBlock x:Name="VaultName" Grid.Column="1" Text="Локальное хранилище" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0" Foreground="#758376"/>
    <Button x:Name="LockButton" Grid.Column="2" Content="Закрыть файл хранилища" Click="LockClick" IsEnabled="False" Visibility="Collapsed"/>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#F1F4EF" Padding="18,9"><TextBlock x:Name="Status" Text="Без интернета и аккаунтов · версия 0.1" TextWrapping="Wrap" FontSize="12"/></Border>
  <Grid>
   <Grid x:Name="Welcome">
    <StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="Ваши пароли. Ваш файл." FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock Text="Создайте зашифрованное хранилище или откройте существующий файл KDBX. Главный пароль требуется при каждом открытии." TextWrapping="Wrap" Foreground="#758376" Margin="0,0,0,24"/>
     <Button Content="Открыть файл хранилища" Style="{StaticResource Primary}" Click="OpenClick" Padding="16,13"/>
     <Button Content="Создать новое…" Click="CreateClick" Padding="16,13"/>
     <TextBlock Text="Восстановления забытого главного пароля нет. Храните отдельную копию зашифрованного файла для защиты от потери носителя." TextWrapping="Wrap" FontSize="12" Foreground="#887548" Margin="0,22,0,0"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="Workspace" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F4F6F1" BorderBrush="#DCE3DC" BorderThickness="0,0,1,0" Padding="10,22">
     <DockPanel><TextBlock DockPanel.Dock="Top" Text="ПАПКИ" Margin="12,0,0,15" FontSize="11" Foreground="#758376"/>
      <StackPanel DockPanel.Dock="Bottom"><Button Content="+ Новая папка" Click="AddFolderClick"/><Button Content="Переименовать" Click="RenameFolderClick"/><Button Content="Удалить пустую папку" Click="DeleteFolderClick"/></StackPanel>
      <ListBox x:Name="FolderList" SelectionChanged="FolderChanged" DisplayMemberPath="Name"/>
     </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="#FBFCFA" BorderBrush="#DCE3DC" BorderThickness="0,0,1,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
       <TextBlock x:Name="FolderTitle" Text="Все папки" FontSize="21" Margin="0,0,0,14"/>
       <UniformGrid Columns="2"><Button x:Name="LoginCategory" Content="Записи" Click="LoginCategoryClick" Style="{StaticResource Primary}"/><Button x:Name="TextCategory" Content="Файлы" Click="TextCategoryClick"/></UniformGrid>
       <TextBox x:Name="Search" TextChanged="SearchChanged" Margin="0,14,0,8" ToolTip="Поиск по названию, логину, сайту и тексту" AutomationProperties.Name="Поиск"/>
       <UniformGrid Columns="2"><Button Content="+ Запись" Click="AddLoginClick"/><Button Content="+ Файл" Click="AddTextClick"/></UniformGrid>
       <TextBlock x:Name="ListCaption" Foreground="#758376" FontSize="12" Margin="4,12,0,0"/>
      </StackPanel>
      <ListBox x:Name="ItemList" SelectionChanged="ItemChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Login}" FontSize="12" Foreground="#758376" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel>
    </Border>
    <Grid Grid.Column="2" Background="White">
     <TextBlock x:Name="EmptyEditor" Text="Выберите элемент слева&#10;или создайте новый." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#758376" TextAlignment="Center"/>
     <DockPanel x:Name="Editor" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Background="#F4F7F1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveState" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Отменить" Click="RevertClick"/><Button x:Name="SaveButton" Grid.Column="2" Content="Сохранить и зашифровать" Click="SaveClick" Style="{StaticResource Primary}"/></Grid></Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
       <TextBlock x:Name="KindCaption" Foreground="#758376" FontSize="12"/>
       <TextBlock x:Name="EditorTitle" FontSize="26" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,24"/>
       <TextBlock Text="НАЗВАНИЕ" Foreground="#758376" FontSize="11" Margin="0,0,0,7"/><TextBox x:Name="TitleField" TextChanged="FieldChanged"/>
       <TextBlock Text="ПАПКА" Foreground="#758376" FontSize="11" Margin="0,18,0,7"/><ComboBox x:Name="ItemFolder" DisplayMemberPath="Name" Padding="8" SelectionChanged="ItemFolderChanged"/>
       <StackPanel x:Name="LoginFields">
        <TextBlock Text="ЛОГИН" Foreground="#758376" FontSize="11" Margin="0,18,0,7"/><TextBox x:Name="LoginField" TextChanged="FieldChanged"/>
        <TextBlock Text="ПАРОЛЬ" Foreground="#758376" FontSize="11" Margin="0,18,0,7"/>
        <DockPanel><Button DockPanel.Dock="Right" x:Name="ShowPassword" Content="Показать" Click="ShowPasswordClick"/><Grid><PasswordBox x:Name="PasswordField" PasswordChanged="PasswordChanged"/><TextBox x:Name="VisiblePassword" Visibility="Collapsed" TextChanged="VisiblePasswordChanged"/></Grid></DockPanel>
        <TextBlock Text="САЙТ" Foreground="#758376" FontSize="11" Margin="0,18,0,7"/><TextBox x:Name="SiteField" TextChanged="FieldChanged"/>
       </StackPanel>
       <TextBlock x:Name="TextCaption" Text="ТЕКСТ" Foreground="#758376" FontSize="11" Margin="0,18,0,7"/><TextBox x:Name="TextField" AcceptsReturn="True" AcceptsTab="True" MinHeight="170" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="FieldChanged"/>
       <Button Content="Удалить элемент" Click="DeleteItemClick" Foreground="#A35C52" HorizontalAlignment="Right" Margin="0,20,0,0"/>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </Grid>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
